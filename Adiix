-- محرك COIN MAGNET: حمل مضمون 100%
-- لا يرجع أبداً قبل أن يتأكد أن الكاش دخل جيبك
--============================================--
local function snatch(cashObj)
    if busy or not magnetOn then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local part = cashObj:IsA("BasePart") and cashObj
        or cashObj:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end

    busy = true
    local spd = SPEEDS[speedMode]
    local returnPos = hrp.CFrame
    local before = coins.Value
    local grabbed = false

    -- 1) انتقال فوق الكاش
    hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    task.wait(spd.tpWait)

    -- 2) حلقة الضغط المضمون: يضغط ويتحقق، ويكرر حتى يدخل المال
    for i = 1, spd.maxTries do
        -- لو الكاش انحذف = شخص آخر أخذه أو نجحنا
        if not cashObj.Parent then grabbed = (coins.Value > before) break end

        local prompt = cashObj:FindFirstChildOfClass("ProximityPrompt", true)
        if prompt then
            -- نصفر زمن الضغطة حتى لا يفشل في السرعات العالية
            pcall(function()
                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 15)
            end)
            pcall(function() fireproximityprompt(prompt) end)
        end
        task.wait(spd.pressWait)

        -- التحقق الحقيقي: هل دخل المال؟
        if coins.Value > before then
            grabbed = true
            break
        end
        -- إعادة تثبيت الموقع فوق الكاش (لو اهتز)
        if hrp.Parent and part.Parent then
            hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
        end
    end

    -- 3) العودة فقط بعد التأكد (أو استنفاد المحاولات)
    if hrp.Parent then hrp.CFrame = returnPos end

    if grabbed then
        local amount = coins.Value - before
        stolenTotal += amount
        updateStatus()
        warn("[Adiiiiiiix] Snatched +" .. amount .. " DH! [" .. txt(SPEEDS[speedMode].key) .. "]")
    else
        warn("[Adiiiiiiix] Grab failed after " .. spd.maxTries .. " tries (someone took it?)")
    end
    busy = false
end

workspace.ChildAdded:Connect(function(obj)
    if obj.Name:lower():find("cash") then
