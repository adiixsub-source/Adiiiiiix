local function renderEsp()
    if isAr() then
        espInfo.Text = "إداريون هنا: " .. espCount
    else
        espInfo.Text = "Staff here: " .. espCount
    end
end
renderEsp()
regRenderer(renderEsp)

local function clearEsp()
    for _, o in pairs(espObjects) do pcall(function() o:Destroy() end) end
    espObjects = {}
end

local function tagPlayer(pl)
    pcall(function()
        if pl == player then return end
        local r = serverRanks[pl.Name]
        local info = r and RANK_DATA[r]
        if not (info and info.isStaff) then return end
        local char = pl.Character
        local head = char and char:FindFirstChild("Head")
        if not head then return end
        if espObjects[pl.Name .. "_bb"] then return end
        local rankName = isAr() and info.ar or info.en

        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 160, 0, 36)
        bb.StudsOffset = Vector3.new(0, 2.8, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = head
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = info.color
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 14
        tl.TextStrokeTransparency = 0.3
        tl.Text = "★ " .. rankName .. " ★"
        tl.Parent = bb

        local hl = Instance.new("Highlight")
        hl.FillColor = info.color
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.FillTransparency = 0.6
        hl.Parent = char

        espObjects[pl.Name .. "_bb"] = bb
        espObjects[pl.Name .. "_hl"] = hl
    end)
end

task.spawn(function()
    while true do
        pcall(function()
            if espOn then
                clearEsp()
                espCount = 0
                for _, pl in ipairs(Players:GetPlayers()) do
                    local r = serverRanks[pl.Name]
                    local info = r and RANK_DATA[r]
                    if info and info.isStaff then
                        espCount += 1
                        tagPlayer(pl)
                    end
                end
            else
                clearEsp()
                espCount = 0
            end
            renderEsp()
        end)
        task.wait(5)
    end
end)

