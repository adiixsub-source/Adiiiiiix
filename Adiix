local function fetchServerRanks()
    pcall(function()
        local sig = RS:FindFirstChild("HDAdminHDClient")
        sig = sig and sig:FindFirstChild("Signals")
        local rf = sig and sig:FindFirstChild("RetrieveServerRanks")
        if rf and rf:IsA("RemoteFunction") then
            local res = rf:InvokeServer()
            if type(res) == "table" then
                local nr = {}
                for _, e in ipairs(res) do
                    if e.Player and e.RankId then nr[e.Player.Name] = tonumber(e.RankId) or e.RankId end
                end
                serverRanks = nr
            end
        end
    end)
end
