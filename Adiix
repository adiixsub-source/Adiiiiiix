local function getDirt()
    local ok, res = pcall(function()
        local j = workspace:FindFirstChild("GenericModels")
        j = j and j:FindFirstChild("CleaningJob")
        local ad = j and j:FindFirstChild("ActiveDirt")
        if not ad then return nil end
        for _, s in ipairs(ad:GetChildren()) do
            if s:IsA("BasePart") then return s end
        end
        return nil
    end)
    if ok then return res end
    return nil
end

local function hasBroom()
    local ok, res = pcall(function()
        local ch = player.Character
        if ch and ch:FindFirstChild("Broom") then return true end
        local bp = player:FindFirstChild("Backpack")
        return bp and bp:FindFirstChild("Broom") ~= nil
    end)
    return ok and res or false
end

local function equipBroom()
    pcall(function()
        local bp = player:FindFirstChild("Backpack")
        local b = bp and bp:FindFirstChild("Broom")
        if b and player.Character then b.Parent = player.Character end
    end)
end

local function takeJob()
    pcall(function()
        local npc = workspace:FindFirstChild("CleaningCompany")
        npc = npc and npc:FindFirstChild("JobNPC")
        if not npc then return end
        local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
        local root = npc:FindFirstChildWhichIsA("BasePart", true)
        local _, hrp = getChar()
        if prompt and root and hrp and hasFPP then
            local origin = hrp.CFrame
            pcall(function() hrp.CFrame = root.CFrame + Vector3.new(0, 3, 2) end)
            task.wait(0.2)
            pcall(function() prompt.HoldDuration = 0 prompt.MaxActivationDistance = 20 fireproximityprompt(prompt) end)
            task.wait(0.3)
            pcall(function()
                local _, h2 = getChar()
                if h2 then h2.CFrame = origin end
            end)
        end
    end)
end

