local function renderServers(list)
    clearList(serversPage)
    local order = 1
    for _, srv in ipairs(list) do
        local isMe = (srv.id == game.JobId)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -4, 0, 52)
        row.BackgroundColor3 = isMe and Color3.fromRGB(70, 55, 15) or Color3.fromRGB(32, 32, 46)
        row.BorderSizePixel = 0
        row.LayoutOrder = order
        row.Parent = serversPage
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)
        if isMe then
            local st = Instance.new("UIStroke", row)
            st.Color = Color3.fromRGB(255, 200, 0)
            st.Thickness = 2
        end

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -70, 1, -8)
        lbl.Position = UDim2.new(0, 12, 0, 4)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Center
        lbl.Text = (isMe and txt("you") or "") .. string.sub(srv.id, 1, 8) ..
            "  |  " .. tostring(srv.playing) .. "/" .. tostring(srv.maxPlayers) ..
            txt("playersWord") .. "\n" .. txt("ping") .. tostring(srv.ping or "?") .. " ms"
        lbl.Parent = row

        if not isMe then
            local joinBtn = Instance.new("TextButton")
            joinBtn.Size = UDim2.new(0, 52, 0, 28)
            joinBtn.Position = UDim2.new(1, -60, 0.5, -14)
            joinBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
            joinBtn.TextColor3 = Color3.new(1, 1, 1)
            joinBtn.Font = Enum.Font.GothamBold
            joinBtn.TextSize = 12
            joinBtn.Text = txt("join")
            joinBtn.Parent = row
            Instance.new("UICorner", joinBtn).CornerRadius = UDim.new(0, 8)
            local jobId = srv.id
            joinBtn.MouseButton1Click:Connect(function()
                joinBtn.Text = "..."
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player)
                end)
                task.wait(3)
                joinBtn.Text = txt("join")
            end)
        end
        order = order + 1
    end
    refreshBtn.Text = txt("refresh") .. " (" .. tostring(order - 1) .. txt("found")
end

local function loadServers()
    refreshBtn.Text = txt("loading")
    task.spawn(function()
        if not httpReq then
            refreshBtn.Text = txt("noHttp")
            task.wait(2)
            refreshBtn.Text = txt("refresh")
            return
        end
        local ok, res = pcall(function()
            return httpReq({
                Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100",
                Method = "GET"
            })
        end)
        if not ok or not res or not res.Body then
            refreshBtn.Text = txt("failed")
            task.wait(2)
            refreshBtn.Text = txt("refresh")
            return
        end
        local data = HttpService:JSONDecode(res.Body)
        lastServers = data.data or {}
        renderServers(lastServers)
    end)
end

refreshBtn.MouseButton1Click:Connect(loadServers)

