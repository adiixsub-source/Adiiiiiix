-- متحكم رقمي (- قيمة +)
local function addStepper(parent, label, default, minV, maxV, step, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundColor3 = CARD
    row.BorderSizePixel = 0
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -150, 1, 0)
    lbl.Position = UDim2.new(0, 140, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = WHITE
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Right
    lbl.Text = label
    lbl.Parent = row

    local val = default
    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 52, 0, 28)
    valLbl.Position = UDim2.new(0, 44, 0.5, -14)
    valLbl.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
    valLbl.TextColor3 = GOLD
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 13
    valLbl.Text = tostring(default)
    valLbl.Parent = row
    Instance.new("UICorner", valLbl).CornerRadius = UDim.new(0, 6)

    local function mkBtn(txt2, x, cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 28, 0, 28)
        b.Position = UDim2.new(0, x, 0.5, -14)
        b.BackgroundColor3 = BTN
        b.TextColor3 = WHITE
        b.Font = Enum.Font.GothamBold
        b.TextSize = 15
        b.Text = txt2
        b.Parent = row
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        b.MouseButton1Click:Connect(cb)
    end
    mkBtn("-", 10, function()
        val = math.max(minV, val - step)
        val = math.floor(val * 10 + 0.5) / 10
        valLbl.Text = tostring(val)
        pcall(callback, val)
    end)
    mkBtn("+", 102, function()
        val = math.min(maxV, val + step)
        val = math.floor(val * 10 + 0.5) / 10
        valLbl.Text = tostring(val)
        pcall(callback, val)
    end)
end

