local function runSweepingStep()
    if isCollectingCash or scriptKilled then return end
    if staffFreezeEnabled and getNearbyStaff(staffFreezeRadius) then return end
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if hum.Sit then
        hum.Sit = false
        task.wait(0.1)
    end

    if autoSweep then
        equipBroom()
    end

    if autoTP then
        local spot = getClosestDirtSpot()
        if spot and spot.Parent and not scriptKilled and not isCollectingCash then
            hrp.CFrame = CFrame.new(spot.Position + Vector3.new(0, 2.5, 0))

            local spotStartTime = tick()
            while spot and spot.Parent and autoTP and not scriptKilled and not isCollectingCash do
                if staffFreezeEnabled and getNearbyStaff(staffFreezeRadius) then
                    break
                end

                if autoCollectCash and #findCashDrops() > 0 then
                    break
                end

                if autoTicTacToe then
                    local _, _, hasOpp = findBestTicTacToeBoard()
                    if hasOpp then
                        break
                    end
                end

                local timeSinceLast = tick() - lastCleanTick
                if timeSinceLast >= SERVER_COOLDOWN and autoSweep and __r26 then
                    __r26:FireServer(spot.Name)
                    task.wait(0.3)
                else
                    task.wait(0.1)
                end

                if tick() - spotStartTime > 12 then
                    break
                end
            end
            task.wait(0.15)
        else
            task.wait(0.5)
        end
    else
        local spot, dist = getClosestDirtSpot()
        if spot and spot.Parent and dist <= 10 and autoSweep then
            local timeSinceLast = tick() - lastCleanTick
            if timeSinceLast >= SERVER_COOLDOWN and __r26 then
                __r26:FireServer(spot.Name)
                lastCleanTick = tick()
                task.wait(0.4)
            end
        end
    end
end


