local jobTried = false
local lastRemote = 0
local function cleanCycle()
    if not cleanOn then jobTried = false task.wait(0.4) return end
    if getNearbyStaff(50) and avoidOn then task.wait(0.5) return end
    local _, hrp = getChar()
    if not hrp then task.wait(0.5) return end
    if not hasBroom() then
        if not jobTried then takeJob() jobTried = true task.wait(1) end
        equipBroom()
        task.wait(0.3)
    end
    local dirt = getDirt()
    if not dirt then task.wait(1) return end
    local v = coins.Value
    pcall(function() hrp.CFrame = dirt.CFrame + Vector3.new(0, 2.5, 0) end)
    local t0 = tick()
    while cleanOn and dirt.Parent and coins.Value == v and tick() - t0 < 4 do
        pcall(function() hrp.CFrame = dirt.CFrame + Vector3.new(0, 2.5, 0) end)
        if __r26 and tick() - lastRemote >= 6.1 then
            pcall(function() __r26:FireServer(dirt.Name) end)
            lastRemote = tick()
        end
        if hasFCD then
            pcall(function()
                local cd = dirt:FindFirstChildOfClass("ClickDetector")
                if cd then fireclickdetector(cd) end
            end)
        end
        task.wait(0.1)
    end
    if coins.Value > v then
        cleanTotal += 1
        earnedTotal += (coins.Value - v)
        renderClean()
    end
    task.wait(0.8)
end
task.spawn(function() while true do pcall(cleanCycle) task.wait(0.1) end end)

