local function makeTab(name, order)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.333, -2, 1, 0)
    b.BackgroundColor3 = GOLD
    b.BackgroundTransparency = 1
    b.TextColor3 = Color3.fromRGB(150, 150, 160)
