local function getDirt()
    local cj = workspace:FindFirstChild("GenericModels")
        and workspace.GenericModels:FindFirstChild("CleaningJob")
    local activeDirt = cj and cj:FindFirstChild("ActiveDirt")
    if not activeDirt then return nil end
    for _, obj in ipairs(activeDirt:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:find("DirtSpot") then
            return obj
        end
    end
    return nil
end

local function hasBroom()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("Broom"))
        or (bp and bp:FindFirstChild("Broom"))
end

local function equipBroom()
    local char = player.Character
    if not char then return false end
    if char:FindFirstChild("Broom") then return true end
    local bp = player:FindFirstChild("Backpack")
    local broom = bp and bp:FindFirstChild("Broom")
    if broom then
        pcall(function() broom.Parent = char end)
        task.wait(0.2)
    end
    return char:FindFirstChild("Broom") ~= nil
end

local function takeJob()
    if hasBroom() then return equipBroom() end
    local npc = workspace:FindFirstChild("GenericModels")
        and workspace.GenericModels:FindFirstChild("CleaningJob")
        and workspace.GenericModels.CleaningJob:FindFirstChild("CleaningCompany")
        and workspace.GenericModels.CleaningJob.CleaningCompany:FindFirstChild("JobNPC")
    if not npc then return false end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local npcPart = npc:FindFirstChildWhichIsA("BasePart", true)
    if not (hrp and npcPart) then return false end
    hrp.CFrame = npcPart.CFrame + Vector3.new(0, 3, 3)
    task.wait(0.4)
    local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function()
            prompt.HoldDuration = 0
            prompt.MaxActivationDistance = 20
        end)
        pcall(function() fireproximityprompt(prompt) end)
        task.wait(0.5)
        pcall(function() fireproximityprompt(prompt) end)
    end
    local t0 = os.clock()
    while os.clock() - t0 < 5 do
        if hasBroom() then break end
        task.wait(0.3)
    end
    return equipBroom()
end

