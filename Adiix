            row.Parent = playersPage
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -140, 1, 0)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = Color3.new(1, 1, 1)
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = pl.DisplayName .. " (@" .. pl.Name .. ")"
            lbl.Parent = row

            local watchBtn = Instance.new("TextButton")
            watchBtn.Size = UDim2.new(0, 60, 0, 28)
            watchBtn.Position = UDim2.new(1, -132, 0.5, -14)
            watchBtn.BackgroundColor3 = Color3.fromRGB(150, 60, 180)
            watchBtn.TextColor3 = Color3.new(1, 1, 1)
            watchBtn.Font = Enum.Font.GothamBold
            watchBtn.TextSize = 11
            watchBtn.Text = txt("watch")
            watchBtn.Parent = row
            Instance.new("UICorner", watchBtn).CornerRadius = UDim.new(0, 8)

            local targetPl = pl
            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.new(0, 60, 0, 28)
            tpBtn.Position = UDim2.new(1, -68, 0.5, -14)
            tpBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
            tpBtn.TextColor3 = Color3.new(1, 1, 1)
            tpBtn.Font = Enum.Font.GothamBold
            tpBtn.TextSize = 11
            tpBtn.Text = txt("tp")
            tpBtn.Parent = row
            Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 8)

            tpBtn.MouseButton1Click:Connect(function()
                local myChar = player.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local tChar = targetPl.Character
                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                if myHrp and tHrp then
                    pcall(function()
                        myHrp.CFrame = tHrp.CFrame + Vector3.new(0, 3, 3)
                    end)
                    statusBar.Text = txt("tpDone") .. targetPl.DisplayName
                    task.wait(1.5)
                    updateStatus()
                end
            end)
            watchBtn.MouseButton1Click:Connect(function()
                if watchTarget == targetPl then
                    stopWatch()
                    watchBtn.Text = txt("watch")
                    watchBtn.BackgroundColor3 = Color3.fromRGB(150, 60, 180)
                    updateStatus()
                else
                    local char = targetPl.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        watchTarget = targetPl
                        camera.CameraSubject = hum
                        watchBtn.Text = txt("stop")
                        watchBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                        statusBar.Text = txt("watching") .. targetPl.DisplayName
                    end
                end
            end)
            order = order + 1
        end
    end
end

