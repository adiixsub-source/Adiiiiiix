local function findXOBoard()
    local ok, b, fr, me = pcall(function()
        local f = workspace:FindFirstChild("TICTACTOE")
        if not f then return nil, nil, false end
        for _, bd in ipairs(f:GetChildren()) do
            if bd.Name == "TICTACTOE_BOARD" then
                local sf = bd:FindFirstChild("scoreFrame")
                local interior = sf and sf:FindFirstChild("interior")
                local sg = interior and interior:FindFirstChild("SurfaceGui")
                local frame = sg and sg:FindFirstChild("Frame")
                if frame then
                    local p1 = frame:FindFirstChild("player1Name")
                    local p2 = frame:FindFirstChild("player2Name")
                    local t1 = (p1 and p1.Text) or ""
                    local t2 = (p2 and p2.Text) or ""
                    local isMe = (t1 == player.Name or t1 == player.DisplayName or t2 == player.Name or t2 == player.DisplayName)
                    local empty1 = (t1 == "" or string.lower(t1) == "none")
                    local empty2 = (t2 == "" or string.lower(t2) == "none")
                    if isMe or empty1 or empty2 then
                        return bd, frame, isMe
                    end
                end
            end
        end
        return nil, nil, false
    end)
    if ok then return b, fr, me end
    return nil, nil, false
end

local WIN_LINES = {{1,2,3},{4,5,6},{7,8,9},{1,4,7},{2,5,8},{3,6,9},{1,5,9},{3,5,7}}
local function getXOState(board)
    local st = {}
    for i = 1, 9 do
        local x = board:FindFirstChild("X" .. i)
        local o = board:FindFirstChild("O" .. i)
        if x and x:IsA("BasePart") and x.Transparency < 0.5 then st[i] = "X"
        elseif o and o:IsA("BasePart") and o.Transparency < 0.5 then st[i] = "O"
        else st[i] = nil end
    end
    return st
end

local function bestMove(st, me, opp)
    for _, l in ipairs(WIN_LINES) do
        local a, b, c = st[l[1]], st[l[2]], st[l[3]]
        local cnt = (a == me and 1 or 0) + (b == me and 1 or 0) + (c == me and 1 or 0)
        if cnt == 2 then
            if not a then return l[1] elseif not b then return l[2] elseif not c then return l[3] end
        end
    end
    for _, l in ipairs(WIN_LINES) do
        local a, b, c = st[l[1]], st[l[2]], st[l[3]]
        local cnt = (a == opp and 1 or 0) + (b == opp and 1 or 0) + (c == opp and 1 or 0)
        if cnt == 2 then
            if not a then return l[1] elseif not b then return l[2] elseif not c then return l[3] end
        end
    end
    if not st[5] then return 5 end
    for _, i in ipairs({1, 3, 7, 9}) do if not st[i] then return i end end
    for _, i in ipairs({2, 4, 6, 8}) do if not st[i] then return i end end
    return nil
end

local xoLastMove = 0
local xoCounted = {}
local function xoCycle()
    if not xoOn then task.wait(0.4) return end
    if getNearbyStaff(50) and avoidOn then task.wait(1) return end
    local board, frame, amSeated = findXOBoard()
    if not board then task.wait(1) return end
    local p1l = frame:FindFirstChild("player1Name")
    local meIsP1 = p1l and (p1l.Text == player.Name or p1l.Text == player.DisplayName)
    local mySym = meIsP1 and "X" or "O"
    if not amSeated then
        if hasFPP then
            local chairName = meIsP1 and "ticTacToeChair1" or "ticTacToeChair2"
            local chair = board.Parent and board.Parent:FindFirstChild(chairName)
            chair = chair or workspace:FindFirstChild(chairName, true)
            if chair then
                local pp = chair:FindFirstChildWhichIsA("ProximityPrompt", true)
                local chPart = chair:IsA("BasePart") and chair or chair:FindFirstChildWhichIsA("BasePart", true)
                local _, h = getChar()
                if pp and chPart and h then
                    pcall(function() h.CFrame = chPart.CFrame + Vector3.new(0, 2, 0) end)
                    task.wait(0.2)
                    pcall(function() pp.HoldDuration = 0 fireproximityprompt(pp) end)
                end
            end
        end
        task.wait(1)
        return
    end
    local st = getXOState(board)
    local mv = bestMove(st, mySym, mySym == "X" and "O" or "X")
    if mv and tick() - xoLastMove > 1.2 and hasFCD then
        pcall(function()
            local det = board:FindFirstChild("Detector" .. mv)
            if det then fireclickdetector(det) end
        end)
        xoLastMove = tick()
    end
    for i = 1, 8 do
        local w = board:FindFirstChild("Win" .. i)
        if w and w:IsA("BasePart") and w.Transparency < 0.5 then
            local l = WIN_LINES[i]
            if st[l[1]] == mySym and not xoCounted[board] then
                xoCounted[board] = true
                xoTotal += 1
                renderXO()
                break
            end
        end
    end
    task.wait(0.5)
end
task.spawn(function() while true do pcall(xoCycle) task.wait(0.1) end end)

