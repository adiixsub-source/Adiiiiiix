    b.TextSize = 13
    b.Text = name
    b.LayoutOrder = order
    b.Parent = tabBar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -20, 1, -110)
    page.Position = UDim2.new(0, 10, 0, 100)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = GOLD
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = panel
    local pl = Instance.new("UIListLayout", page)
    pl.Padding = UDim.new(0, 6)
    pl.SortOrder = Enum.SortOrder.LayoutOrder

    tabs[name] = b
    pages[name] = page
    b.MouseButton1Click:Connect(function()
        for n, btn in pairs(tabs) do
            local active = (n == name)
            btn.BackgroundTransparency = active and 0 or 1
            btn.TextColor3 = active and Color3.fromRGB(15, 15, 22) or Color3.fromRGB(150, 150, 160)
            pages[n].Visible = active
        end
    end)
    return page
end

