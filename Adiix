-- noclip يشتغل ويبقى حتى بعد الرجوع فوق الأرض
local function stealthNoclipOn()
    if stealthNoclip then return end
    stealthNoclip = RunService.Stepped:Connect(function()
        pcall(function()
            local char = player.Character
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)
    end)
end

local function stealthNoclipOff()
    if stealthNoclip then
        pcall(function() stealthNoclip:Disconnect() end)
        stealthNoclip = nil
    end
    pcall(function()
        local char = player.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.CanCollide = true
                end
            end
        end
    end)
end

local function stealthSafeOff()
    pcall(function()
        local _, h = getChar()
        if h and stealthAnchored then h.Anchored = false stealthAnchored = false end
    end)
    stealthNoclipOff()
end

stealthSw.onClick(function(s)
    stealthOn = s
    if not s then stealthSafeOff() end
end)
local stealthSpeed = SPEED_LEVELS[1]
addSpeedRow(stealthCard, 92, 1, function(i) stealthSpeed = SPEED_LEVELS[i] end)

local function stealthCycle()
    if not stealthOn then task.wait(0.4) return end
    if getNearbyStaff(50) and avoidOn then task.wait(0.5) return end
    local char, hrp = getChar()
    if not hrp then task.wait(0.5) return end

    local list = findCash()
    if #list == 0 then task.wait(0.6) return end

    local sp = stealthSpeed
    local origin = hrp.CFrame
    local originY = hrp.Position.Y

    stealthNoclipOn()

    for _, target in ipairs(list) do
        if not stealthOn then break end
        if not (target and target.Parent) then continue end

        local v = coins.Value
        local underPos = target.CFrame - Vector3.new(0, STEALTH_DEPTH, 0)

        pcall(function()
            hrp.CFrame = underPos
            hrp.Anchored = true
            stealthAnchored = true
        end)
        task.wait(sp.tpWait)
        fireCash(target)

        -- الضمان الكامل: لا خروج حتى يدخل المبلغ أو يختفي الكاش
        while stealthOn and coins.Value == v and target.Parent do
            pcall(function()
                local _, h3 = getChar()
                if h3 and h3.Anchored then h3.CFrame = underPos end
            end)
            task.wait(sp.fireGap)
            fireCash(target)
        end

        pcall(function()
            local _, h4 = getChar()
            if h4 then h4.Anchored = false stealthAnchored = false end
        end)

        if coins.Value > v then
            cashTotal += 1
            earnedTotal += (coins.Value - v)
            renderStealth()
        end
    end

    -- الرجوع فقط بعد الانتهاء من الأخذ
    pcall(function()
        local _, h5 = getChar()
        if h5 then
            h5.Anchored = false
            stealthAnchored = false
            h5.CFrame = origin
            h5.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
    task.wait(0.15)
    stealthNoclipOff()

    -- حارس الفراغ
    pcall(function()
        local _, h6 = getChar()
        if h6 and h6.Position.Y < originY - 40 then
            stealthNoclipOn()
            h6.CFrame = origin
            h6.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            task.wait(0.15)
            stealthNoclipOff()
        end
    end)

    task.wait(sp.cooldown)
end
task.spawn(function() while true do pcall(stealthCycle) task.wait(0.1) end end)

player.CharacterAdded:Connect(function()
    stealthAnchored = false
    stealthNoclipOff()
end)

